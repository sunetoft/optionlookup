generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("FREE")  // FREE, PAID, ADMIN
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts        Account[]
  sessions        Session[]
  bookmarks       Bookmark[]
  analyses        AnalysisHistory[]
  subscriptions   Subscription[]
  importedStocks  ImportedStock[]
  passwordResets  PasswordReset[]
  scanTickers     ScanTicker[]
  scanCategories  ScanCategory[]
}

model PasswordReset {
  token     String   @id
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ImportedStock {
  id        String   @id @default(cuid())
  userId    String
  ticker    String
  source    String   @default("tradescouter")  // "tradescouter" | "themeinvestor"
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ticker, source])
  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  ticker    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ticker])
  @@index([userId])
}

model AnalysisHistory {
  id        String   @id @default(cuid())
  userId    String?
  ticker    String
  data      String
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([ticker])
}

model Subscription {
  id                     String   @id @default(cuid())
  userId                 String
  stripeCustomerId       String?  @unique
  stripeSubscriptionId   String?  @unique
  stripePriceId          String?
  tier                   String   // MONTHLY, QUARTERLY, SEMI_ANNUAL, ANNUAL
  status                 String   @default("ACTIVE") // ACTIVE, CANCELED, PAST_DUE, TRIALING
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean  @default(false)
  renewalReminderSent    Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model AnonymousUsage {
  id              String    @id @default(cuid())
  identifier      String    @unique  // IP address or fingerprint
  lookupCount     Int       @default(0)
  tickersLooked   String    @default("")  // comma-separated tickers
  quarantinedUntil DateTime?
  firstLookupAt   DateTime  @default(now())
  lastLookupAt    DateTime  @default(now())

  @@index([identifier])
}

model EmailLog {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  subject   String
  type      String   // RENEWAL_REMINDER, WELCOME, QUARANTINE, CANCELLATION, SCANNER_DIGEST
  sentAt    DateTime @default(now())
  success   Boolean  @default(true)
  error     String?

  @@index([email])
  @@index([type, sentAt])
}

// ── CSP Scanner Models ────────────────────────────────────────────────

model ScanCategory {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String   @default("amber")  // amber, blue, green, red, purple, cyan, pink, orange
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  scanTickers  ScanTicker[]

  @@unique([userId, name])
  @@index([userId])
}

model ScanTicker {
  id           String   @id @default(cuid())
  userId       String
  ticker       String
  priceTarget  Float
  categoryId   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     ScanCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  scanResults  ScanResult[]
  scanRuns     ScanRun[]

  @@unique([userId, ticker])
  @@index([userId])
  @@index([categoryId])
}

model ScanResult {
  id              String   @id @default(cuid())
  scanTickerId    String
  scanRunId       String
  optionType      String   @default("PUT")  // "PUT" (CSP) | "CALL" (covered call)
  strike          Float
  expiration      String   // YYYY-MM-DD
  dte             Int
  bid             Float
  ask             Float
  roiPerDay       Float
  totalRoi        Float
  openInterest    Int      @default(0)
  volume          Int      @default(0)
  impliedVol      Float    @default(0)
  earningsWarning Boolean  @default(false)
  emWarning       Boolean  @default(false)
  scannedAt       DateTime @default(now())

  scanTicker      ScanTicker @relation(fields: [scanTickerId], references: [id], onDelete: Cascade)

  @@index([scanTickerId, optionType])
  @@index([scanRunId])
  @@index([scannedAt])
}

model ScanRun {
  id             String   @id @default(cuid())
  scanTickerId   String
  userId         String
  ticker         String
  scanType       String   // "scheduled" | "manual"
  totalPuts      Int      @default(0)
  qualifiedPuts  Int      @default(0)
  totalCalls     Int      @default(0)
  qualifiedCalls Int      @default(0)
  currentPrice   Float?
  earningsDate   String?
  scannedAt      DateTime @default(now())

  scanTicker    ScanTicker @relation(fields: [scanTickerId], references: [id], onDelete: Cascade)

  @@index([userId, ticker])
  @@index([scannedAt])
}
